# API base URL — Vite proxies /api to the server in dev, so use relative path
VITE_API_URL=/api

# App name shown in the UI
VITE_APP_NAME=Job Portal

# Social Auth — Google OAuth Client ID (from https://console.cloud.google.com/apis/credentials)
# Must match GOOGLE_CLIENT_ID in server/.env
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Social Auth — Apple Service ID (from https://developer.apple.com/account/resources/identifiers)
# Must match APPLE_CLIENT_ID in server/.env
VITE_APPLE_CLIENT_ID=com.example.yourapp.signin
